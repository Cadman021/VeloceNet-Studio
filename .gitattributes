# The Flutter tool writes its generated plugin registrants with LF and rewrites
# them on every `flutter pub get` / `flutter run`. With core.autocrlf=true git
# expects CRLF in the worktree, so those files show up as modified right after
# every pub get even though their content is byte-identical to HEAD. Pin them
# to LF so the property matches what the tool writes.
windows/flutter/generated_plugin_registrant.cc text eol=lf
windows/flutter/generated_plugin_registrant.h text eol=lf
windows/flutter/generated_plugins.cmake text eol=lf
linux/flutter/generated_plugin_registrant.cc text eol=lf
linux/flutter/generated_plugin_registrant.h text eol=lf
linux/flutter/generated_plugins.cmake text eol=lf
macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf

# Everything that runs on Linux (or is sourced by a POSIX shell) must keep
# LF in the repository: a CRLF shebang fails as "bad interpreter: /bin/sh^M".
deploy/linux/*.sh text eol=lf
deploy/linux/*.service text eol=lf
deploy/linux/*.default text eol=lf
deploy/linux/debian/* text eol=lf
deploy/kubernetes/*.yaml text eol=lf
tool/*.py text eol=lf
docs/completions/* text eol=lf
docs/netstudio-headless.1 text eol=lf
docs/netstudio-headless.schema.json text eol=lf
native_engine/Dockerfile text eol=lf
